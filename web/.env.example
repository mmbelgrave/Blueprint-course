# Copy this file to ".env.local" and fill in the values. Never share .env.local.
# Without the two Supabase values the app runs in local preview mode.

# Supabase -> Project Settings -> API (public values, safe in the browser)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Needed from milestone 3 on (server only, SECRET) ---
# Supabase -> Project Settings -> API -> service_role key
SUPABASE_SERVICE_ROLE_KEY=
# console.anthropic.com -> API Keys
ANTHROPIC_API_KEY=
# Only if the key is NOT created inside a workspace: the workspace ID (wrkspc_...)
ANTHROPIC_WORKSPACE_ID=
# The email address you sign in with as admin
ADMIN_EMAIL=

# --- Online pilot ---
# "true" = only people you invited in Supabase can sign in. Anyone else gets a
# friendly "not on the list yet" message and cannot start an account, so a
# stranger who finds the address cannot spend your AI credit.
# Empty or "false" = anyone with the address can make an account.
NEXT_PUBLIC_INVITE_ONLY=

# --- Selling (spec 6.1) ---
# "true" = people only open what they own. Leave it empty while you are still
# testing: everyone signed in can then open every released step.
# IMPORTANT: it is read when the app is BUILT, so set it for Production AND
# Preview in Vercel, and redeploy.
NEXT_PUBLIC_REQUIRE_PURCHASE=

# Lemon Squeezy -> Settings -> Webhooks. Make one webhook per mode, pointing at
# https://app.maderealblueprint.com/api/lemonsqueezy/webhook, subscribed to
# order_created and order_refunded. The signing secret is shown once.
LS_WEBHOOK_SECRET_LIVE=
LS_WEBHOOK_SECRET_TEST=

# The NUMBER of the variant, from the product's variant page -- not the id in
# the checkout link, which is a different kind of id.
LS_VARIANT_PHASE1=
LS_VARIANT_FULL=

# "true" lets a TEST order open the real app. Only while you are testing.
ALLOW_TEST_ORDERS=

# Where the welcome email tells people to go.
NEXT_PUBLIC_APP_URL=https://app.maderealblueprint.com

# --- Email (Resend) ---
# resend.com -> API Keys. Without it: questions are saved but not emailed, and
# a new buyer gets no welcome email (Admin says so).
RESEND_API_KEY=
