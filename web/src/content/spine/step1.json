        {
          "id": "3.5",
          "title": "A first money check",
          "fields": [
            {
              "id": "monthly",
              "type": "calculation",
              "rows": [
                {
                  "id": "income",
                  "label": "1. My income per month in my new life (from 3.4)",
                  "example": "€1,600",
                  "from": {
                    "exercise": "3.4",
                    "field": "income",
                    "column": "new_life"
                  }
                },
                {
                  "id": "costs",
                  "label": "2. My costs per month in my new life (from 3.2)",
                  "example": "€2,000",
                  "from": {
                    "exercise": "3.2",
                    "field": "costs",
                    "column": "new_life"
                  }
                },
                {
                  "id": "balance",
                  "label": "3. Left over or short each month (1 minus 2)",
                  "example": "€400 short",
                  "formula": "income - costs",
                  "format": "left_or_short"
                }
              ]
            },
            {
              "id": "savings",
              "type": "calculation",
              "rows": [
                {
                  "id": "savings",
                  "label": "4. Savings I can use within a month",
                  "example": "€30,000",
                  "input": "money"
                },
                {
                  "id": "one_time",
                  "label": "5. Minus: the one-time cost of the change (from 3.3)",
                  "example": "− €6,000",
                  "from": {
                    "exercise": "3.3",
                    "field": "one_time",
                    "column": "amount"
                  }
                },
                {
                  "id": "deposits",
                  "label": "6. Minus: deposits, money I pay now and may only get back much later",
                  "example": "− €1,650",
                  "input": "money"
                },
                {
                  "id": "reserve",
                  "label": "7. Minus: my reserve, money I keep for emergencies and not to live on",
                  "example": "− €6,000",
                  "input": "money"
                },
                {
                  "id": "available",
                  "label": "8. Savings left to live on (4 minus 5, 6 and 7)",
                  "example": "€16,350",
                  "formula": "savings - one_time - deposits - reserve"
                }
              ]
            },
            {
              "id": "months",
              "type": "calculation",
              "rows": [
                {
                  "id": "months",
                  "label": "9. Months my savings can cover: line 8 divided by the amount I am short (line 3)",
                  "example": "€16,350 ÷ €400 = about 40 months",
                  "formula": "available / -balance",
                  "condition": "balance < 0",
                  "format": "months"
                }
              ]
            },
            {
              "id": "deeper",
              "type": "long_text"
